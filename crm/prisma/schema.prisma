// Zafoor Clinic CRM — data model
// Trimmed from the original hospital-crm baseline down to what a single
// outpatient review clinic needs: Patient CRM, Appointments, EMR (encounter
// workflow), Billing, and Website content management. Hospital-operations
// (beds/ICU/OT/ambulance/pharmacy-inventory) and HRMS (payroll/recruitment/
// chat/etc.) were dropped — see ARCHITECTURE.md for the audit that justifies
// each removal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Staff identity + auth
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  BILLING
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?
  passwordHash     String
  role             StaffRole
  specialization   String?
  consultationFee  Decimal?  @db.Decimal(10, 2)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  sessions Session[]

  registeredPatients   Patient[]            @relation("PatientRegisteredBy")
  doctorAvailabilities DoctorAvailability[]
  doctorLeaves         DoctorLeave[]
  appointmentsAsDoctor Appointment[]        @relation("AppointmentDoctor")
  appointmentsCreated  Appointment[]        @relation("AppointmentCreatedBy")
  prescriptionsWritten Prescription[]       @relation("PrescriptionDoctor")
  documentsUploaded    Document[]           @relation("DocumentUploadedBy")
  messagesSent         Message[]            @relation("MessageSentBy")
  notesWritten         PatientNote[]        @relation("NoteAuthor")
  followUpsAssigned    FollowUp[]           @relation("FollowUpAssignedTo")
  waitingListEntries   WaitingListEntry[]   @relation("WaitingListDoctor")

  encountersAsDoctor    Encounter[]        @relation("EncounterDoctor")
  clinicalNotesWritten  ClinicalNote[]     @relation("ClinicalNoteDoctor")
  doctorTemplates       DoctorTemplate[]   @relation("DoctorTemplateOwner")
  digitalSignature      DigitalSignature?  @relation("DoctorSignature")
  clinicalReportsOrdered ClinicalReport[]  @relation("ClinicalReportDoctor")
  referralsWritten      ReferralNote[]     @relation("ReferralFromDoctor")
  certificatesIssued    Certificate[]      @relation("CertificateDoctor")

  paymentsReceived   Payment[]        @relation("PaymentReceivedBy")
  refundsProcessed   Refund[]         @relation("RefundProcessedBy")
  advancesReceived   PatientAdvance[] @relation("AdvanceReceivedBy")
  cashSessionsOpened CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]    @relation("CashSessionClosedBy")
  expensesRecorded   Expense[]        @relation("ExpenseRecordedBy")

  inventoryTransactions InventoryTransaction[] @relation("InventoryPerformedBy")
  auditLogs             AuditLog[]             @relation("AuditUser")

  @@index([role])
}

// Server-side session for cookie-based auth (replaces the getCurrentUser() placeholder)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Atomic named sequence counters (UHID / bill number / appointment ID generation)
model Counter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// Patient — the single digital identity
// ─────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id             String        @id @default(cuid())
  uhid           String        @unique
  firstName      String
  lastName       String?
  dob            DateTime?
  gender         Gender?
  bloodGroup     BloodGroup?   @default(UNKNOWN)
  occupation     String?
  phone          String
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?       @default("India")
  photoUrl       String?
  status         PatientStatus @default(ACTIVE)
  notesSummary   String?

  // set when the patient originates from a website booking rather than
  // front-desk registration, so the CRM can show its source
  source String? @default("CRM")

  registeredById String?
  registeredBy   User?   @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  registrationStatus RegistrationStatus @default(CONFIRMED)
  lockedAt           DateTime?
  lockedById         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags                    PatientTag[]
  familyMembers           FamilyMember[]
  insurances              Insurance[]
  emergencyContacts       EmergencyContact[]
  medicalAlerts           MedicalAlert[]
  allergies               Allergy[]
  chronicDiseases         ChronicDisease[]
  documents               Document[]
  communicationPreference CommunicationPreference?
  appointments            Appointment[]
  waitingListEntries      WaitingListEntry[]
  prescriptions           Prescription[]
  bills                   Bill[]
  payments                Payment[]
  messages                Message[]
  notes                   PatientNote[]
  followUps               FollowUp[]
  feedback                Feedback[]
  relatedToFamilyOf       FamilyMember[]           @relation("RelatedPatient")

  encounters         Encounter[]
  medicalHistory     MedicalHistory[]
  familyHistory      FamilyHistoryEntry[]
  surgicalHistory    SurgicalHistory[]
  currentMedications CurrentMedication[]
  clinicalReports    ClinicalReport[]
  referralNotes      ReferralNote[]
  certificates       Certificate[]

  inventoryTransactions InventoryTransaction[]

  refunds  Refund[]
  advances PatientAdvance[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([registrationStatus])
  @@index([firstName, lastName])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String       @default("#1F6F78")
  patients PatientTag[]
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([patientId, tagId])
}

model FamilyMember {
  id                 String    @id @default(cuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relatedPatientId   String?
  relatedPatient     Patient?  @relation("RelatedPatient", fields: [relatedPatientId], references: [id])
  name               String
  relation           String
  phone              String?
  dob                DateTime?
  isEmergencyContact Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([patientId])
}

model Insurance {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider       String
  policyNumber   String
  planName       String?
  coverageAmount Decimal?  @db.Decimal(12, 2)
  validFrom      DateTime?
  validTo        DateTime?
  isPrimary      Boolean   @default(true)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())

  bills Bill[]

  @@index([patientId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  altPhone  String?
  address   String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  ALLERGY
  CONDITION
  DEVICE
  BEHAVIORAL
  OTHER
}

model MedicalAlert {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  description String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([patientId])
}

model Allergy {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  AlertSeverity @default(MEDIUM)
  notedOn   DateTime      @default(now())

  @@index([patientId])
}

enum ChronicDiseaseStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

model ChronicDisease {
  id          String               @id @default(cuid())
  patientId   String
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  diagnosedOn DateTime?
  status      ChronicDiseaseStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime             @default(now())

  @@index([patientId])
}

enum DocumentCategory {
  ID_PROOF
  INSURANCE
  LAB_REPORT
  PRESCRIPTION
  CONSENT_FORM
  OTHER
}

model Document {
  id           String           @id @default(cuid())
  patientId    String
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  category     DocumentCategory @default(OTHER)
  fileUrl      String
  fileType     String?
  uploadedById String?
  uploadedBy   User?            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime         @default(now())

  @@index([patientId])
  @@index([category])
}

enum CommChannel {
  SMS
  EMAIL
  WHATSAPP
  CALL
  SYSTEM
}

model CommunicationPreference {
  id                String      @id @default(cuid())
  patientId         String      @unique
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredChannel  CommChannel @default(SMS)
  allowSms          Boolean     @default(true)
  allowEmail        Boolean     @default(true)
  allowWhatsapp     Boolean     @default(true)
  allowCall         Boolean     @default(true)
  allowMarketing    Boolean     @default(false)
  preferredLanguage String      @default("English")
  updatedAt         DateTime    @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Services — the clinic's consultation catalog (Hairfall Review, Acne
// Review, Thyroid Review, ...). Admin-managed from the CRM; the public
// website reads this table to render service pages and drive booking.
// ─────────────────────────────────────────────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortDescription String?
  description     String?
  price           Decimal? @db.Decimal(10, 2)
  durationMinutes Int      @default(30)
  displayOrder    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bills        Bill[]
  appointments Appointment[]
  reviews      Review[]

  @@index([active])
}

// ─────────────────────────────────────────────────────────────────────────
// Appointment system
// ─────────────────────────────────────────────────────────────────────────

model DoctorAvailability {
  id                  String   @id @default(cuid())
  doctorId            String
  doctor              User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0 = Sunday .. 6 = Saturday
  startTime           String // "18:00"
  endTime             String // "22:00"
  slotDurationMinutes Int      @default(30)
  isActive            Boolean  @default(true)

  @@index([doctorId])
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, date])
}

enum AppointmentType {
  IN_PERSON
  WALK_IN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  WEBSITE
  CRM
  PHONE
}

model Appointment {
  id              String            @id @default(cuid())
  appointmentCode String            @unique
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User              @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  type            AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(PENDING)
  source          AppointmentSource @default(CRM)
  reason          String?
  notes           String?
  cancelReason    String?
  cancelledAt     DateTime?
  checkedInAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  rescheduledFromId String?
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")

  createdById String?
  createdBy   User?    @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  bills         Bill[]
  prescriptions Prescription[]
  feedback      Feedback[]
  followUps     FollowUp[]
  encounters    Encounter[]

  @@index([patientId])
  @@index([doctorId, scheduledAt])
  @@index([status])
}

enum WaitingListStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

model WaitingListEntry {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?             @relation("WaitingListDoctor", fields: [doctorId], references: [id])
  requestedDate DateTime?
  reason        String?
  priority      Int               @default(0)
  status        WaitingListStatus @default(WAITING)
  createdAt     DateTime          @default(now())

  @@index([patientId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Prescriptions / Billing / Payments
// ─────────────────────────────────────────────────────────────────────────

model Prescription {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User         @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  encounterId   String?
  encounter     Encounter?   @relation(fields: [encounterId], references: [id])
  diagnosis     String?
  notes         String?
  issuedAt      DateTime     @default(now())

  items PrescriptionItem[]

  @@index([patientId])
  @@index([encounterId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  @@index([prescriptionId])
}

enum BillStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     String     @unique
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  insuranceId    String?
  insurance      Insurance? @relation(fields: [insuranceId], references: [id])
  serviceId      String?
  service        Service?   @relation(fields: [serviceId], references: [id])
  totalAmount    Decimal    @db.Decimal(12, 2) @default(0)
  discountAmount Decimal    @db.Decimal(12, 2) @default(0)
  taxAmount      Decimal    @db.Decimal(12, 2) @default(0)
  netAmount      Decimal    @db.Decimal(12, 2) @default(0)
  amountPaid     Decimal    @db.Decimal(12, 2) @default(0)
  balanceDue     Decimal    @db.Decimal(12, 2) @default(0)
  status         BillStatus @default(PENDING)
  issuedAt       DateTime   @default(now())
  cancelledAt    DateTime?

  items              BillItem[]
  payments           Payment[]
  refunds            Refund[]
  advanceAdjustments AdvanceAdjustment[]

  @@index([patientId])
  @@index([status])
}

model BillItem {
  id             String  @id @default(cuid())
  billId         String
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRatePercent Decimal @db.Decimal(5, 2) @default(0)
  taxAmount      Decimal @db.Decimal(12, 2) @default(0)
  amount         Decimal @db.Decimal(12, 2)

  @@index([billId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  INSURANCE
  ADVANCE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  billId          String?
  bill            Bill?         @relation(fields: [billId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(SUCCESS)
  referenceNumber String?
  cashSessionId   String?
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime      @default(now())

  refunds Refund[]

  @@index([patientId])
  @@index([cashSessionId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Refund {
  id            String       @id @default(cuid())
  billId        String?
  bill          Bill?        @relation(fields: [billId], references: [id])
  paymentId     String?
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(12, 2)
  reason        String
  method        PaymentMethod
  status        RefundStatus @default(PENDING)
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?        @relation("RefundProcessedBy", fields: [processedById], references: [id])

  @@index([patientId])
  @@index([status])
}

model PatientAdvance {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  balance         Decimal  @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  receivedById    String?
  receivedBy      User?    @relation("AdvanceReceivedBy", fields: [receivedById], references: [id])
  paidAt          DateTime @default(now())
  notes           String?

  adjustments AdvanceAdjustment[]

  @@index([patientId])
}

model AdvanceAdjustment {
  id         String         @id @default(cuid())
  advanceId  String
  advance    PatientAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  billId     String
  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(12, 2)
  adjustedAt DateTime       @default(now())

  @@index([advanceId])
  @@index([billId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String            @id @default(cuid())
  openedById      String
  openedBy        User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedById      String?
  closedBy        User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  openingBalance  Decimal           @db.Decimal(12, 2) @default(0)
  closingBalance  Decimal?          @db.Decimal(12, 2)
  expectedClosing Decimal?          @db.Decimal(12, 2)
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  notes           String?

  payments Payment[]

  @@index([status])
}

enum ExpenseCategory {
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  RENT
  EQUIPMENT
  OTHER
}

model Expense {
  id              String          @id @default(cuid())
  category        ExpenseCategory
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @default(now())
  paidTo          String?
  method          PaymentMethod
  referenceNumber String?
  recordedById    String?
  recordedBy      User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([category])
  @@index([expenseDate])
}

// ─────────────────────────────────────────────────────────────────────────
// CRM — Notes, Follow-ups, Communication log, Feedback
// ─────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id        String           @id @default(cuid())
  patientId String
  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel   CommChannel
  direction MessageDirection @default(OUTBOUND)
  subject   String?
  body      String
  status    MessageStatus    @default(SENT)
  sentById  String?
  sentBy    User?            @relation("MessageSentBy", fields: [sentById], references: [id])
  sentAt    DateTime         @default(now())

  @@index([patientId])
  @@index([channel])
}

enum NoteCategory {
  GENERAL
  CLINICAL
  BILLING
  FRONT_DESK
}

model PatientNote {
  id        String       @id @default(cuid())
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  category  NoteCategory @default(GENERAL)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([patientId])
}

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model FollowUp {
  id            String         @id @default(cuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  dueDate       DateTime
  reason        String
  status        FollowUpStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([patientId])
  @@index([status, dueDate])
}

// Internal (CRM-side) feedback captured after a visit — distinct from the
// public-facing Review model below, which is admin-curated for the website.
model Feedback {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  category      String?
  createdAt     DateTime     @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// EMR — Encounter is the anchor for a single consultation: chief
// complaints, vitals, diagnoses, the SOAP note, and prescriptions issued
// during that visit all hang off it.
// ─────────────────────────────────────────────────────────────────────────

enum EncounterStatus {
  DRAFT
  FINALIZED
}

model Encounter {
  id              String          @id @default(cuid())
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User            @relation("EncounterDoctor", fields: [doctorId], references: [id])
  appointmentId   String?
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  encounterDate   DateTime        @default(now())
  chiefComplaints String[]
  status          EncounterStatus @default(DRAFT)
  signedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vitals        Vitals[]
  diagnoses     Diagnosis[]
  clinicalNote  ClinicalNote?
  prescriptions Prescription[]
  reports       ClinicalReport[]

  @@index([patientId])
  @@index([doctorId])
}

model Vitals {
  id              String    @id @default(cuid())
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId       String
  heightCm        Decimal?  @db.Decimal(5, 1)
  weightKg        Decimal?  @db.Decimal(5, 1)
  bmi             Decimal?  @db.Decimal(4, 1)
  temperatureC    Decimal?  @db.Decimal(4, 1)
  pulseBpm        Int?
  bpSystolic      Int?
  bpDiastolic     Int?
  spo2            Int?
  recordedAt      DateTime  @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

model Diagnosis {
  id          String          @id @default(cuid())
  encounterId String
  encounter   Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  description String
  icdCode     String?
  type        DiagnosisType   @default(PRIMARY)
  status      DiagnosisStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())

  @@index([encounterId])
  @@index([patientId])
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

model ClinicalNote {
  id          String             @id @default(cuid())
  encounterId String             @unique
  encounter   Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  doctorId    String
  doctor      User               @relation("ClinicalNoteDoctor", fields: [doctorId], references: [id])
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  status      ClinicalNoteStatus @default(DRAFT)
  version     Int                @default(1)
  signedAt    DateTime?
  updatedAt   DateTime           @updatedAt
  createdAt   DateTime           @default(now())

  versions ClinicalNoteVersion[]

  @@index([patientId])
}

model ClinicalNoteVersion {
  id             String       @id @default(cuid())
  clinicalNoteId String
  clinicalNote   ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)
  versionNumber  Int
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  savedAt        DateTime     @default(now())

  @@index([clinicalNoteId])
}

model MedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description String
  occurredOn  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

model FamilyHistoryEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model SurgicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure   String
  surgeryDate DateTime?
  surgeon     String?
  hospital    String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

enum MedicationStatus {
  ACTIVE
  STOPPED
}

model CurrentMedication {
  id           String           @id @default(cuid())
  patientId    String
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName String
  dosage       String?
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  status       MedicationStatus @default(ACTIVE)
  prescribedBy String?
  notes        String?
  createdAt    DateTime         @default(now())

  @@index([patientId])
}

enum DoctorTemplateType {
  SOAP
  PRESCRIPTION
  CERTIFICATE
}

model DoctorTemplate {
  id         String             @id @default(cuid())
  doctorId   String
  doctor     User               @relation("DoctorTemplateOwner", fields: [doctorId], references: [id], onDelete: Cascade)
  name       String
  type       DoctorTemplateType
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  content    String?
  createdAt  DateTime           @default(now())

  @@index([doctorId])
}

model DigitalSignature {
  id           String   @id @default(cuid())
  doctorId     String   @unique
  doctor       User     @relation("DoctorSignature", fields: [doctorId], references: [id], onDelete: Cascade)
  signatureUrl String
  updatedAt    DateTime @updatedAt
}

enum ClinicalReportType {
  LAB
  RADIOLOGY
}

enum ClinicalReportStatus {
  PENDING
  COMPLETED
}

model ClinicalReport {
  id            String               @id @default(cuid())
  patientId     String
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?                @relation("ClinicalReportDoctor", fields: [doctorId], references: [id])
  encounterId   String?
  encounter     Encounter?           @relation(fields: [encounterId], references: [id])
  type          ClinicalReportType
  title         String
  modality      String?
  findings      String?
  impression    String?
  status        ClinicalReportStatus @default(PENDING)
  reportDate    DateTime             @default(now())
  attachmentUrl String?
  createdAt     DateTime             @default(now())

  labResults LabResultItem[]

  @@index([patientId])
  @@index([type])
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
}

model LabResultItem {
  id             String         @id @default(cuid())
  reportId       String
  report         ClinicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  testName       String
  value          String
  unit           String?
  referenceRange String?
  flag           ResultFlag     @default(NORMAL)

  @@index([reportId])
}

enum ReferralUrgency {
  ROUTINE
  URGENT
}

model ReferralNote {
  id           String          @id @default(cuid())
  patientId    String
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromDoctorId String
  fromDoctor   User            @relation("ReferralFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor     String
  toSpecialty  String?
  reason       String
  notes        String?
  urgency      ReferralUrgency @default(ROUTINE)
  signedAt     DateTime?
  createdAt    DateTime        @default(now())

  @@index([patientId])
}

enum CertificateType {
  FITNESS
  SICK_LEAVE
  MEDICAL
  OTHER
}

model Certificate {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User            @relation("CertificateDoctor", fields: [doctorId], references: [id])
  type      CertificateType
  title     String
  content   String
  validFrom DateTime?
  validTo   DateTime?
  signedAt  DateTime?
  createdAt DateTime        @default(now())

  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Website content management — lets clinic admins edit the public site
// without touching code.
// ─────────────────────────────────────────────────────────────────────────

model ClinicSettings {
  id String @id @default("clinic")

  name       String  @default("Zafoor Clinic")
  addressLine String @default("No. 69/70, St. Xavier Street, Broadway, Sevenwells, George Town, Chennai - 600001, Tamil Nadu, India")
  landmark   String  @default("Opposite Huda Mosque")
  phone      String  @default("8940399403")
  email      String  @default("ZafoorClinic@gmail.com")
  mapQuery   String  @default("Zafoor Clinic, St. Xavier Street, George Town, Chennai")

  weekdayOpen  String  @default("18:00") // Mon-Sat
  weekdayClose String  @default("22:00")
  sundayClosed Boolean @default(true)

  heroHeadline String? @default("Trusted healthcare for your everyday health.")
  aboutText    String?

  updatedAt DateTime @updatedAt
}

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Admin-curated, published testimonials for the public website. Never
// auto-generated — every row is entered by clinic staff from a real
// patient review.
model Review {
  id            String   @id @default(cuid())
  patientName   String
  rating        Int
  comment       String
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  published     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Registration Status & Locking
// ─────────────────────────────────────────────────────────────────────────

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  LOCKED_FOR_RECEPTIONIST
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory System — Medicines, Stock In/Out, 20% Alerts
// ─────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                       String   @id @default(cuid())
  name                     String
  category                 String   @default("Medicine")
  manufacturer             String?
  sku                      String   @unique
  unit                     String   @default("Unit")
  description              String?
  currentStock             Int      @default(0)
  referenceStock           Int      @default(20)
  lowStockThresholdPercent Decimal  @db.Decimal(5, 2) @default(20)
  lowStockThresholdQty     Int      @default(4)
  unitPrice                Decimal? @db.Decimal(10, 2)
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  transactions InventoryTransaction[]
  alerts       InventoryAlert[]

  @@index([category])
  @@index([active])
  @@index([name])
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  itemId        String
  item          InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  patientId     String?
  patient       Patient?                 @relation(fields: [patientId], references: [id])
  performedById String
  performedBy   User                     @relation("InventoryPerformedBy", fields: [performedById], references: [id])
  timestamp     DateTime                 @default(now())

  @@index([itemId])
  @@index([type])
  @@index([performedById])
  @@index([timestamp])
}

enum InventoryAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum InventoryAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model InventoryAlert {
  id                String                 @id @default(cuid())
  itemId            String
  item              InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  alertType         String                 @default("LOW_STOCK")
  severity          InventoryAlertSeverity @default(HIGH)
  currentQuantity   Int
  thresholdQuantity Int
  status            InventoryAlertStatus   @default(ACTIVE)
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  resolvedAt        DateTime?
  resolvedById      String?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([itemId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Logging
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation("AuditUser", fields: [userId], references: [id])
  userName   String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

