# Postgres connection string. The public website (../website) MUST point
# at this same database — that's how a website booking shows up in the CRM
# instantly, with no sync job. See ../website/.env.example.
DATABASE_URL="postgresql://zafoor:zafoor_password@localhost:5432/zafoor_clinic"

# Supabase Project Configuration
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Optional notification keys
EMAIL_API_KEY=""
SMS_API_KEY=""
